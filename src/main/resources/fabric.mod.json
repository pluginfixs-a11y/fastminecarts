  ],
  "contact": {},
  "license": "MIT",
  "icon": "",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.fastminecarts.FastMinecarts"
    ]
  },
  "mixins": [
    "fastminecarts.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
